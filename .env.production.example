# Plantilla de .env para el VPS (subdominio de prueba con Docker).
# Copiar a `.env` en el propio VPS y completar los valores marcados.
# Este archivo NUNCA se copia dentro de la imagen (ver .dockerignore);
# docker-compose lo lee directo desde el servidor con `env_file: .env`.

APP_NAME=AulaMaster
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aulamastertest.codermaster.com.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# "mysql" es el nombre del servicio de docker-compose, no una IP: Docker lo
# resuelve solo por su red interna. No cambiar a 127.0.0.1 aquí.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aulamaster
DB_USERNAME=aulamaster
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
# Solo la usa el contenedor de mysql para crear el usuario root la primera vez.
DB_ROOT_PASSWORD=CAMBIAR_ESTA_CLAVE_ROOT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@codermaster.com.co"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Fase 17: pasarela de pagos Wompi. Dejar vacío hasta tener cuenta/credenciales.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
